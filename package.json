{
  "name": "threejs-r183-app",
  "version": "1.0.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "start": "parcel src/index.html",
    "dev": "parcel src/index.html",
    "dashboard": "npx serve dashboard -l 5050",
    "dashboard:export": "node tools/export-dashboard-data.js",
    "build": "parcel build src/index.html --dist-dir dist",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p jsconfig.json",
    "check:boundaries": "node tools/check-boundaries.mjs",
    "test:purity": "node packages/physics/test/purity.test.mjs",
    "test:layer0": "node packages/physics/test/layer0-identity.test.mjs",
    "test:counterfactual": "node packages/physics/test/counterfactual.test.mjs",
    "constants:generate": "node tools/constants/generate.mjs --write",
    "test:constants": "node tools/constants/generate.mjs",
    "test:fixtures": "node tools/fixtures/record-tools-lib.mjs",
    "test:literals": "node tools/constants/check-literals.mjs",
    "test:verify": "node tools/verify/run-suite.mjs",
    "test:pipeline": "node tools/fit/verify-pipeline.js",
    "test:verify:list": "node tools/verify/run-suite.mjs --list",
    "test:snapshot": "node test/browser/snapshot.test.mjs",
    "test:transparency": "node test/browser/transparency.test.mjs",
    "test:browser": "npm run build && npm run test:snapshot",
    "targets": "node tools/fixtures/report-targets.mjs",
    "check": "npm run lint && npm run typecheck && npm run check:boundaries && npm run test:purity && npm run test:layer0 && npm run test:constants && npm run test:counterfactual && npm run test:fixtures && npm run test:literals && npm run test:verify && npm run test:pipeline"
  },
  "dependencies": {
    "three": "^0.183.0",
    "tweakpane": "^4.0.5"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.0",
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.1.2",
    "eslint": "^9.39.5",
    "eslint-plugin-boundaries": "^7.1.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^63.3.2",
    "parcel": "^2.16.4",
    "playwright": "^1.62.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "xlsx": "^0.18.5"
  }
}
